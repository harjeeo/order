// Prisma schema for the Order Dashboard backend.
// Mirrors the shapes used by the frontend's lib/mockApi.ts so swapping
// the frontend from mock data to real API calls is a 1:1 mapping.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Platform / multi-tenancy --------------------------------------------

enum TenantStatus {
  active
  suspended
}

enum TenantPlan {
  Free
  Basic
  Pro
}

model Tenant {
  id          String       @id @default(cuid())
  name        String
  ownerName   String
  phone       String       @default("")
  email       String       @default("")
  address     String       @default("")
  status      TenantStatus @default(active)
  plan        TenantPlan   @default(Free)
  planExpiry  DateTime?
  createdAt   DateTime     @default(now())

  users       User[]
  outlets     Outlet[]
  categories  MenuCategory[]
  menuItems   MenuItem[]
  tables      Table[]
  customers   Customer[]
  orders      Order[]
  invoices    Invoice[]
  ingredients Ingredient[]
  stockMoves  StockMovement[]
  recipes     RecipeIngredient[]
  expenses    Expense[]
  printLogs   PrintLog[]
  notificationLogs NotificationLog[]
  shifts      Shift[]
  settings    Settings?
  coupons      Coupon[]
  reservations Reservation[]
}

// --- Outlets / branches ----------------------------------------------
// Pro-plan multi-outlet support: staff share one login across every
// outlet under their tenant and switch between them in the UI. Menu,
// tables, inventory and orders are scoped per-outlet; staff, customers,
// expenses and invoices stay shared across the whole tenant.
model Outlet {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  address   String   @default("")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  categories   MenuCategory[]
  menuItems    MenuItem[]
  tables       Table[]
  orders       Order[]
  ingredients  Ingredient[]
  reservations Reservation[]
  invoices     Invoice[]
  expenses     Expense[]

  @@index([tenantId])
}

model PlatformSettings {
  id              String  @id @default(cuid())
  platformName    String  @default("Order Dashboard")
  supportEmail    String  @default("")
  billingEmail    String  @default("")
  planPricing     Json    @default("{\"Free\":0,\"Basic\":499,\"Pro\":1999}")
  trialDays       Int     @default(14)
  allowSelfSignup Boolean @default(true)

  // Pluggable transactional-email config (client/staff credential emails).
  // `provider` picks which nested block is active; adding a new provider
  // later is just a new key here plus a case in src/lib/email.ts — no
  // migration needed since it's JSON.
  emailSettings Json @default("{\"provider\":\"none\",\"fromName\":\"Order Dashboard\",\"fromEmail\":\"\",\"mailjet\":{\"apiKey\":\"\",\"apiSecret\":\"\"},\"brevo\":{\"apiKey\":\"\"}}")

  // Pluggable SMS/WhatsApp config for "order ready" / "bill paid" customer
  // notifications — same shape as emailSettings above.
  smsSettings Json @default("{\"provider\":\"none\",\"twilio\":{\"accountSid\":\"\",\"authToken\":\"\",\"fromNumber\":\"\"}}")
}

// --- Menu icon library ----------------------------------------------------

// A platform-level, Super-Admin-curated set of icons cafe owners pick from
// when adding a menu item, instead of uploading their own photo — keeps
// every cafe's menu grid visually consistent instead of a mix of stretched
// or mismatched images. Not tenant-scoped: one shared library for everyone,
// managed centrally.
model MenuIcon {
  id        String   @id @default(cuid())
  name      String
  image     String
  createdAt DateTime @default(now())
}

// --- Users / staff / roles ------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  MANAGER
  CASHIER
  WAITER
  KITCHEN_STAFF
}

model User {
  id               String    @id @default(cuid())
  tenantId         String?
  tenant           Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name             String
  email            String    @unique
  passwordHash     String
  role             Role
  phone            String    @default("")
  active           Boolean   @default(true)
  permissions      Json      @default("{}")
  monthlySalary    Int       @default(0)
  lastSalaryPaidAt DateTime?
  twoFactorSecret  String?
  twoFactorEnabled Boolean   @default(false)
  createdAt        DateTime  @default(now())

  shifts Shift[]

  @@index([tenantId])
}

// --- Menu -------------------------------------------------------------

model MenuCategory {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outletId String
  outlet   Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)
  name     String

  items MenuItem[]

  @@unique([outletId, name])
  @@index([tenantId])
}

model MenuItem {
  id         String       @id @default(cuid())
  tenantId   String
  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outletId   String
  outlet     Outlet       @relation(fields: [outletId], references: [id], onDelete: Cascade)
  categoryId String
  category   MenuCategory @relation(fields: [categoryId], references: [id])
  name       String
  image      String       @default("🍽️")
  price      Int
  tax        Float        @default(5)
  available  Boolean      @default(true)

  variants MenuVariant[]
  addons   MenuAddon[]
  recipe   RecipeIngredient[]

  @@index([tenantId])
  @@index([outletId])
}

model MenuVariant {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  price      Int
}

model MenuAddon {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  price      Int
}

// --- Tables -------------------------------------------------------------

enum TableStatus {
  available
  occupied
  reserved
  billing
}

model Table {
  id       String      @id @default(cuid())
  tenantId String
  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outletId String
  outlet   Outlet      @relation(fields: [outletId], references: [id], onDelete: Cascade)
  number   String
  capacity Int
  status   TableStatus @default(available)

  orders       Order[]
  reservations Reservation[]

  @@index([tenantId])
  @@index([outletId])
}

// --- Table reservations ----------------------------------------------

enum ReservationStatus {
  booked
  seated
  cancelled
  no_show
}

model Reservation {
  id           String            @id @default(cuid())
  tenantId     String
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outletId     String
  outlet       Outlet            @relation(fields: [outletId], references: [id], onDelete: Cascade)
  tableId      String?
  table        Table?            @relation(fields: [tableId], references: [id])
  customerName String
  phone        String            @default("")
  partySize    Int
  reservedFor  DateTime
  status       ReservationStatus @default(booked)
  notes        String            @default("")
  createdAt    DateTime          @default(now())

  @@index([tenantId])
  @@index([outletId])
}

// --- Customers ------------------------------------------------------------

model Customer {
  id            String @id @default(cuid())
  tenantId      String
  tenant        Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name          String
  phone         String @default("")
  email         String @default("")
  address       String @default("")
  loyaltyPoints Int    @default(0)

  orders Order[]

  @@index([tenantId])
}

// --- Orders / KOT ---------------------------------------------------------

enum OrderType {
  dine_in
  takeaway
  delivery
}

enum OrderStatus {
  pending
  preparing
  ready
  completed
  cancelled
}

enum PaymentStatus {
  unpaid
  paid
  refunded
}

enum OrderSource {
  staff
  customer
}

model Order {
  id            String        @id @default(cuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outletId      String
  outlet        Outlet        @relation(fields: [outletId], references: [id], onDelete: Cascade)
  orderNumber   String
  orderType     OrderType
  source        OrderSource   @default(staff)
  tableId       String?
  table         Table?        @relation(fields: [tableId], references: [id])
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  customerName  String        @default("Walk-in Customer")
  waiter        String        @default("")
  status        OrderStatus   @default(pending)
  paymentStatus PaymentStatus @default(unpaid)
  amount        Int           @default(0)
  notes         String        @default("")
  createdAt     DateTime      @default(now())

  items    OrderItem[]
  invoices Invoice[]
  kot      KitchenTicket?

  @@unique([tenantId, orderNumber])
  @@index([tenantId])
  @@index([outletId])
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String?
  name       String
  qty        Int
  unitPrice  Int     @default(0)
  notes      String  @default("")
}

enum KotStatus {
  new
  preparing
  ready
  completed
}

model KitchenTicket {
  id          String    @id @default(cuid())
  tenantId    String
  orderId     String    @unique
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderNumber String
  status      KotStatus @default(new)
  priority    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([tenantId])
}

// --- Billing ----------------------------------------------------------

model Invoice {
  id                   String   @id @default(cuid())
  tenantId             String
  tenant               Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outletId             String
  outlet               Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  invoiceNumber        String
  orderId              String
  order                Order    @relation(fields: [orderId], references: [id])
  customerName         String   @default("")
  subtotal             Int
  discountAmount       Int      @default(0)
  serviceChargeAmount  Int      @default(0)
  taxAmount            Int      @default(0)
  roundOff             Float    @default(0)
  total                Int
  tipAmount            Int      @default(0)
  couponCode           String   @default("")
  method               String
  refunded             Boolean  @default(false)
  rating               Int?
  feedbackNote         String   @default("")
  createdAt            DateTime @default(now())

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([outletId])
}

// --- Coupons / promo codes -----------------------------------------------

enum CouponType {
  percent
  fixed
}

model Coupon {
  id        String     @id @default(cuid())
  tenantId  String
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code      String
  type      CouponType
  value     Int
  maxUses   Int?
  usedCount Int        @default(0)
  expiresAt DateTime?
  active    Boolean    @default(true)
  createdAt DateTime   @default(now())

  @@unique([tenantId, code])
  @@index([tenantId])
}

// --- Inventory ------------------------------------------------------------

model Ingredient {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outletId String
  outlet   Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)
  name     String
  unit     String @default("kg")
  stock    Float  @default(0)
  minimum  Float  @default(0)

  movements StockMovement[]
  recipeUses RecipeIngredient[]

  @@index([tenantId])
  @@index([outletId])
}

// --- Recipes ----------------------------------------------------------

// Links a menu item to the ingredients (and quantities) consumed to make
// one unit of it. Used to auto-deduct stock when an order is placed.
model RecipeIngredient {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  menuItemId   String
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  qty          Float

  @@unique([menuItemId, ingredientId])
  @@index([tenantId])
}

enum StockMovementType {
  in
  out
  adjustment
  wastage
}

model StockMovement {
  id           String            @id @default(cuid())
  tenantId     String
  tenant       Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient        @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  type         StockMovementType
  qty          Float
  note         String            @default("")
  createdAt    DateTime          @default(now())

  @@index([tenantId])
}

// --- Expenses ---------------------------------------------------------

model Expense {
  id       String   @id @default(cuid())
  tenantId String
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  outletId String
  outlet   Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  category String
  amount   Int
  date     DateTime
  method   String
  notes    String   @default("")

  @@index([tenantId])
  @@index([outletId])
}

// --- Staff shifts / attendance -----------------------------------------

model Shift {
  id        String    @id @default(cuid())
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  clockIn   DateTime  @default(now())
  clockOut  DateTime?

  @@index([tenantId])
  @@index([userId])
}

// --- Print / reprint audit trail -------------------------------------

enum PrintLogType {
  kot
  invoice
}

enum PrintLogAction {
  print
  reprint
  download
}

// Real record behind the "Print KOT" / "Print Invoice" / "Reprint" /
// "Download Invoice" buttons — refId is whatever was printed (an order,
// kitchen ticket, or invoice id depending on type).
model PrintLog {
  id        String         @id @default(cuid())
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  type      PrintLogType
  action    PrintLogAction
  refId     String
  createdAt DateTime       @default(now())

  @@index([tenantId])
}

// --- Customer notifications (SMS/WhatsApp) -------------------------------

enum NotificationChannel {
  sms
}

enum NotificationStatus {
  sent
  logged
}

// One row per notification attempt ("order ready", "bill paid"), whether
// or not a real SMS provider is configured — status is "logged" when it
// wasn't (see src/lib/sms.ts), so the history is visible before a
// provider is switched on, same as PrintLog for print/reprint actions.
model NotificationLog {
  id        String              @id @default(cuid())
  tenantId  String
  tenant    Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  to        String
  message   String
  status    NotificationStatus
  createdAt DateTime            @default(now())

  @@index([tenantId])
}

// --- Platform-level audit trail (Super Admin actions on tenants) --------

// Not tenant-scoped — this records what a Super Admin (or the automatic
// plan-expiry check) did to a tenant, so it survives that tenant being
// deleted. actorId is nullable for system-initiated entries.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String
  actorRole  String
  action     String
  targetType String
  targetId   String?
  meta       Json     @default("{}")
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([createdAt])
}

// --- Per-tenant settings (Restaurant profile, GST/Tax, Invoice, KOT, Printer, Payments) --

model Settings {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  restaurant     Json @default("{}")
  tax            Json @default("{}")
  invoice        Json @default("{}")
  kot            Json @default("{}")
  printer        Json @default("{}")
  paymentMethods Json @default("{}")
}
