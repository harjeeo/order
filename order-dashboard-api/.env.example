DATABASE_URL="postgresql://postgres:postgres@localhost:5432/order_dashboard"
JWT_SECRET="change-this-to-a-long-random-string"
PORT=4000

# Production only (server refuses to start in production without JWT_SECRET set above).
# NODE_ENV=production
# CORS_ORIGIN="https://app.yourdomain.com,https://admin.yourdomain.com"

# Used by `npm run db:seed` — required in production, optional in dev
# (falls back to the demo owner@orderdashboard.example / password123 login).
# SUPER_ADMIN_EMAIL="you@yourdomain.com"
# SUPER_ADMIN_PASSWORD="a-strong-password"
# SEED_DEMO_DATA=true   # force-create the sample cafe/menu even in production
